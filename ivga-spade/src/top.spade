// Native registers only support synchronous reset in this compiler. Use the
// Artix-7 asynchronous-preset primitive; INIT=1 also holds reset at startup.
#[no_mangle(all)]
extern entity FDPE<#uint INIT>(C: clock, CE: bool, D: bool, PRE: bool, Q: inv bool);

#[no_mangle(all)]
entity top(clk: clock, r#reset: bool, led: inv [bool; 4]) {
    // The dedicated chipKIT reset input on C2 is active low.
    let reset_asserted = !r#reset;
    let (stage1, stage1_out) = port();
    let (stage2, stage2_out) = port();
    #[verilog_attrs(ASYNC_REG = "TRUE", RESET_SYNC = "TRUE")]
    let _ = inst FDPE::<1>(clk, true, false, reset_asserted, stage1_out);
    #[verilog_attrs(ASYNC_REG = "TRUE", RESET_SYNC = "TRUE")]
    let _ = inst FDPE::<1>(clk, true, stage1, reset_asserted, stage2_out);

    set led = [inst lib::main(clk, stage2), false, false, false];
}
