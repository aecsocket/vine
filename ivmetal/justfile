default:
    @just --list

# Run without graphics. Use Ctrl-A, X to close.
run:
    cargo build --release --package ivmetal --target x86_64-unknown-uefi
    uefi-run ../target/x86_64-unknown-uefi/release/ivmetal.efi \
        --bios-path /usr/share/edk2/ovmf/OVMF_CODE.fd \
        --boot \
        -- -nographic -no-reboot
