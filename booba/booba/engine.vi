use arithmetic::{Vec2, Rot2};
use arithmetic as _;
use #root::ops::elementwise as _;

pub struct* Engine(pub {
  bodies: List[RigidBody],
  gravity: Vec2,
});

#[impl(Show)]
pub struct* RigidBody(pub {
  position: Vec2,
  rotation: Rot2,
  linear_velocity: Vec2,
  angular_velocity: F32,
  collider: Collider,
  inverse_mass: F32,
  restitution: F32,
});

#[impl(Show)]
pub enum* Collider {
  Circle({ radius: F32 }),
  Rectangle({ half_size: Vec2 }),
}

pub mod Collider {
  pub fn .vertices(&collider: &Collider) -> Option[List[Vec2]] {
    match collider {
      Collider::Circle({ radius: _ }) { None() }
      Collider::Rectangle({ half_size: (hx, hy) }) {
        Some([
          (-hx,  hy),
          ( hx,  hy),
          ( hx, -hy),
          (-hx, -hy),
        ])
      }
    }
  }
}

pub mod Engine {
  pub fn .update(&engine: &Engine, dt: F32) {
    integrate_bodies(&engine, dt);
    resolve_all_contacts(&engine);
  }
}

fn resolve_all_contacts(&engine: &Engine) {
  // TODO: replace with a real broadphase

  let bodies = engine.bodies;
  let processed = [];

  while bodies.head_tail() is Some((body_a, tail)) {
    for body_b in &tail {
      contact::resolve_contacts(&body_a, body_b);
    }

    processed.push_back(body_a);
    bodies = tail;
  }

  engine.bodies = processed;
}

fn integrate_bodies(&engine: &Engine, dt: F32) {
  for &body in &engine.bodies {
    if body.inverse_mass <= 0.0 {
      continue;
    }

    body.linear_velocity += engine.gravity * dt;
    body.position += body.linear_velocity * dt;

    let delta_angle = body.angular_velocity * dt;
    let delta_rotation = Rot2::from_angle(delta_angle);
    body.rotation = delta_rotation * body.rotation;
  }
}
