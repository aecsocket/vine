mod sat;

use engine::{RigidBody, Collider};
use arithmetic as _;
use arithmetic::{Vec2, UnitVec2, Rot2};
use #root::ops::elementwise as _;

pub fn resolve_contacts(
  &body_a: &RigidBody,
  &body_b: &RigidBody,
) {
  let inverse_rot_a = body_a.rotation.inverse();
  let rel_position = inverse_rot_a * (body_b.position - body_a.position);
  let rel_rotation = inverse_rot_a * body_b.rotation;

  let contact = match find_contacts(
    &body_a.collider,
    &body_b.collider,
    rel_position,
    rel_rotation,
  ) {
    Some(contact) { contact }
    None() { return; }
  };
  contact.normal = body_a.rotation * contact.normal;
  // we know they're colliding; let's apply impulses to solve it

  let inverse_mass_sum = body_a.inverse_mass + body_b.inverse_mass;
  let restitution = effective_restitution(body_a.restitution, body_b.restitution);
  if inverse_mass_sum <= 0.0 {
    // two static bodies colliding?
    return;
  }

  let inertia_a = inverse_inertia(&body_a);
  let inertia_b = inverse_inertia(&body_b);
  let normal = contact.normal.get();
  let constraints = [make_constraint(&body_a, &body_b, contact.point1.position, normal, restitution)];
  if contact.point2 is Some(point) {
    constraints.push_back(make_constraint(&body_a, &body_b, point.position, normal, restitution));
  }

  // Coupled contacts need multiple passes; accumulated impulses prevent pulling
  // bodies together and allow later passes to undo an excessive earlier impulse.
  for _ in 0..8 {
    for &constraint in &constraints {
      solve_constraint(&body_a, &body_b, &constraint, normal, inertia_a, inertia_b);
    }
  }

  // separately from velocity, we want to push them apart *right now*
  // so that they're no longer touching.
  // this part is NOT physically correct, but useful for simulation stability.

  // how far apart do we push them?
  // the maximum of how deep either of the two points are inside.
  let depth1 = contact.point1.depth;
  let depth2 = contact.point2.map(fn? (point: ContactPoint) { point.depth }).or_use(0.0);
  let depth = if depth1 > depth2 { depth1 } else { depth2 };

  let correction = contact.normal.get() * (0.8 * depth / inverse_mass_sum);
  body_b.position += correction * body_b.inverse_mass;
  body_a.position -= correction * body_a.inverse_mass;
}

struct* ContactConstraint({
  offset_a: Vec2,
  offset_b: Vec2,
  target_velocity: F32,
  impulse: F32,
});

fn cross((ax, ay): Vec2, (bx, by): Vec2) -> F32 {
  ax * by - ay * bx
}

fn point_velocity(&body: &RigidBody, (x, y): Vec2) -> Vec2 {
  body.linear_velocity + (-y, x) * body.angular_velocity
}

// Uniform solid disk/rectangle inertia. Zero inverse mass denotes a static body.
fn inverse_inertia(&body: &RigidBody) -> F32 {
  if body.inverse_mass <= 0.0 { return 0.0; }
  let inertia_per_mass = match body.collider {
    Collider::Circle({ radius }) { radius * radius * 0.5 }
    Collider::Rectangle({ half_size: (x, y) }) { (x * x + y * y) / 3.0 }
  };
  if inertia_per_mass > 0.0 { body.inverse_mass / inertia_per_mass } else { 0.0 }
}

fn make_constraint(
  &body_a: &RigidBody,
  &body_b: &RigidBody,
  local_point: Vec2,
  normal: Vec2,
  restitution: F32,
) -> ContactConstraint {
  let world_point = body_a.rotation * local_point + body_a.position;
  let offset_a = world_point - body_a.position;
  let offset_b = world_point - body_b.position;
  let velocity = (point_velocity(&body_b, offset_b) - point_velocity(&body_a, offset_a)).dot(normal);
  ContactConstraint({
    offset_a: offset_a,
    offset_b: offset_b,
    // Don't bounce resting contacts from tiny gravity-induced approach speeds.
    target_velocity: if velocity < -1.0 { -restitution * velocity } else { 0.0 },
    impulse: 0.0,
  })
}

fn solve_constraint(
  &body_a: &RigidBody,
  &body_b: &RigidBody,
  &constraint: &ContactConstraint,
  normal: Vec2,
  inertia_a: F32,
  inertia_b: F32,
) {
  let arm_a = cross(constraint.offset_a, normal);
  let arm_b = cross(constraint.offset_b, normal);
  let effective_inverse_mass = body_a.inverse_mass + body_b.inverse_mass
    + arm_a * arm_a * inertia_a + arm_b * arm_b * inertia_b;
  if effective_inverse_mass <= 0.0 { return; }
  let velocity = (point_velocity(&body_b, constraint.offset_b)
    - point_velocity(&body_a, constraint.offset_a)).dot(normal);
  let previous = constraint.impulse;
  constraint.impulse = (previous + (constraint.target_velocity - velocity) / effective_inverse_mass).max(0.0);
  let magnitude = constraint.impulse - previous;
  let impulse = normal * magnitude;
  body_a.linear_velocity -= impulse * body_a.inverse_mass;
  body_b.linear_velocity += impulse * body_b.inverse_mass;
  body_a.angular_velocity -= arm_a * magnitude * inertia_a;
  body_b.angular_velocity += arm_b * magnitude * inertia_b;
}

/// Compute the restitution of two bodies' restitution values.
//
// Currently this is hardcoded to `max(a, b)`, so that we get the bounciest
// results possible, but in a real physics engine you can use other functions
// like the minimum or the average. Box2D uses `max(a, b)`.
fn effective_restitution(a: F32, b: F32) -> F32 {
  if a > b { a } else { b }
}

struct* ContactManifold(pub {
  normal: UnitVec2,
  point1: ContactPoint,
  point2: Option[ContactPoint],
});

struct* ContactPoint(pub {
  position: Vec2,
  depth: F32,
});

/// Find whether two colliders are overlapping, and if so, what the collision
/// normal and depth is.
///
/// This function runs in collider A's reference frame; we assume that A is at
/// position (0, 0, 0) and has no rotation.
fn find_contacts(
  &collider_a: &Collider,
  &collider_b: &Collider,
  position_b: Vec2,
  rotation_b: Rot2,
) -> Option[ContactManifold] {
  match (collider_a, collider_b) {
    (
      Collider::Circle({ radius: radius_a }),
      Collider::Circle({ radius: radius_b }),
    ) { contact_circle_circle(radius_a, radius_b, position_b) }
    (
      Collider::Rectangle({ half_size: half_size_a }),
      Collider::Circle({ radius: radius_b }),
    ) { contact_rectangle_circle(half_size_a, radius_b, position_b) }
    (
      Collider::Circle({ radius: radius_a }),
      Collider::Rectangle({ half_size: half_size_b }),
    ) {
      inverse_of(position_b, rotation_b, fn? (new_position) {
        contact_rectangle_circle(half_size_b, radius_a, new_position)
      })
    }
    (
      Collider::Rectangle({ half_size: (hx_a, hy_a) }),
      Collider::Rectangle({ half_size: (hx_b, hy_b) }),
    ) {
      let vertices_a = [
        (-hx_a,  hy_a),
        (-hx_a, -hy_a),
        ( hx_a, -hy_a),
        ( hx_a,  hy_a),
      ];
      let vertices_b = [
        rotation_b * (-hx_b,  hy_b) + position_b,
        rotation_b * (-hx_b, -hy_b) + position_b,
        rotation_b * ( hx_b, -hy_b) + position_b,
        rotation_b * ( hx_b,  hy_b) + position_b,
      ];
      sat::find_contacts(&vertices_a, &vertices_b)
    }
  }
}

fn inverse_of[F?; fn F(Vec2) -> Option[ContactManifold]](
  position_b: Vec2,
  rotation_b: Rot2,
  f: F,
) -> Option[ContactManifold] {
  let position_b_in_frame_a = rotation_b.inverse() * -position_b;
  f(position_b_in_frame_a).map(fn? (manifold: ContactManifold) {
    ContactManifold({
      normal: -(rotation_b * manifold.normal),
      point1: ContactPoint({
        position: rotation_b * manifold.point1.position + position_b,
        depth: manifold.point1.depth,
      }),
      point2: manifold.point2.map(fn? (point: ContactPoint) {
        ContactPoint({
          position: rotation_b * point.position + position_b,
          depth: point.depth,
        })
      })
    })
  })
}

/// Body A is a circle with radius `radius_a` at the origin.
/// Body B is a circle at `position_b` relative to A.
fn contact_circle_circle(
  radius_a: F32,
  radius_b: F32,
  position_b: Vec2,
) -> Option[ContactManifold] {
  let distance = position_b.len();
  if distance > radius_a + radius_b {
    return None();
  }

  Some(ContactManifold({
    normal: position_b.normalize().or_use(UnitVec2::x),
    point1: ContactPoint({
      position: position_b * 0.5,
      depth: radius_a + radius_b - distance,
    }),
    point2: None(),
  }))
}

/// Body A is a rectangle with half-extents `half_size_a` at the origin, axis-aligned.
/// Body B is a circle at `position_b` relative to A.
fn contact_rectangle_circle(
  half_size_a: Vec2,
  radius_b: F32,
  position_b: Vec2,
) -> Option[ContactManifold] {
  // find closest point of circle on the rect
  let closest = position_b.clamp(-half_size_a, half_size_a);
  // how far is the circle from the closest point it could be
  // on the rect?
  let delta = position_b - closest;

  let (normal, dist) = delta.normalize_with_len();
  if dist > radius_b {
    return None();
  }

  let (normal, depth) = match normal {
    Some(v) { (v, radius_b - dist) }
    None() {
      // circle's center lies exactly on a rectangle's edge
      // so we find the nearest edge
      let (cx, cy) = position_b;
      let (hx, hy) = half_size_a;
      let (dist_x, dist_y) = (hx - cx.abs(), hy - cy.abs());

      let normal;
      let face_distance;
      if dist_x <= dist_y {
        normal = if cx >= 0.0 { UnitVec2::x } else { UnitVec2::nx };
        face_distance = dist_x;
      } else {
        normal = if cy >= 0.0 { UnitVec2::y } else { UnitVec2::ny };
        face_distance = dist_y;
      }

      (normal, radius_b + face_distance)
    }
  }

  // find the point on the circle's surface
  // (that is, circle pos + some unit vec * radius)
  // where the collision is happening *on the circle*
  let circle_surface = position_b + (normal.get() * radius_b);
  // find the contact point, halfway between
  // the closest point on the rect surface
  // and the contact point on the circle surface
  let contact_point = circle_surface.midpoint(closest);

  Some(ContactManifold({
    normal: normal,
    point1: ContactPoint({
      position: contact_point,
      depth: depth,
    }),
    point2: None(),
  }))
}
