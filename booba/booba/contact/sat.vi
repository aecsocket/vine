use arithmetic as _;
use arithmetic::{Vec2, UnitVec2};
use contact::{ContactManifold, ContactPoint};
use util::iter::peeking as _;

pub fn find_contacts(
  &vertices_a: &List[Vec2],
  &vertices_b: &List[Vec2],
) -> Option[ContactManifold] {
  let face_a = match find_face(&vertices_a, &vertices_b) {
    Some(face) { face }
    None() { return None(); }
  };
  let face_b = match find_face(&vertices_b, &vertices_a) {
    Some(face) { face }
    None() { return None(); }
  };
  // overlapping!

  if face_a.separation >= face_b.separation {
    build_manifold(face_a, &vertices_b, false)
  } else {
    build_manifold(face_b, &vertices_a, true)
  }
}

struct* Face({
  start: Vec2,
  end: Vec2,
  normal: UnitVec2,
  separation: F32,
});

fn find_face(
  &vertices: &List[Vec2],
  &other_vertices: &List[Vec2],
) -> Option[Face] {
  let first_vertex = match vertices.pop_front() {
    Some(vertex) { vertex }
    None() {
      // this polygon has no vertices; no way there can be a contact,
      // so they must be separating
      return None();
    }
  };
  vertices.push_front(first_vertex);

  // SAT tells us whether two polygons are overlapping or not,
  // but we also need to know how far into each other they're overlapping.
  // so we keep track of the face in this polygon which is the MOST separated
  // from the other polygon.
  //
  // why do we keep track of the most separated one?
  // well, if a face *is* overlapping, then its separation will be negative -
  // that is, it won't be separated, but rather overlapping.
  // out of all the faces that are overlapping, we want to find the one
  // which is overlapping the *least* - that's the face with the
  // *shallowest penetration* between the two polygons, and the one with the
  // highest separation, so the shallowest penetration.
  // we choose the shallowest penetration one, because we need to move the
  // bodies the *least* along that face normal to separate the two.
  // ideally, we resolve the contact with the least displacement.
  let most_separated_face = None[Face]();

  let iter = vertices.iter_ref().forked().peeking();
  while iter.next() is Some(current) {
    // given a list of vertices [A, B, C, D]
    // we get the following (current, next) pairs:
    // - (A, B)
    // - (B, C)
    // - (C, D)
    // - (D, A)
    // with the way we use `pop_front`, `push_front`, and `first_vertex`,
    // I *believe* this is the optimal way to read these pairs.
    let next = iter.peek().as_fork().or_use(first_vertex);

    // `edge` is the face/edge we're currently working on
    // and `axis` is its normal,
    // using which we're gonna project a bunch of vertices
    let (edge_x, edge_y) = next - current;
    let normal = match (edge_y, -edge_x).normalize() {
      Some(normal) { normal }
      None() {
        // edge_y, edge_x are zero or close to zero;
        // likely `edge` is a duplicate of the last point,
        // so we should have handled this on the last iteration.
        // ignored!
        continue;
      }
    }

    // project polygon B's vertices onto the face
    // of polygon A that we're looking at rn
    let (other_min, _) = project(&other_vertices, normal);
    let separation = other_min - current.dot(normal.get());
    if separation > 0.0 {
      // you're never gonna believe this, but the polygons
      // are separated...
      return None();
    }

    // so we know these two polygons are NOT separated
    let face = Face({
      start: current,
      end: next,
      normal: normal,
      separation: separation,
    });

    most_separated_face = match most_separated_face {
      None() { Some(face) }
      Some(last) {
        if separation > last.separation {
          // we've found a new face which is the most separated so far
          Some(face)
        } else {
          Some(last)
        }
      }
    };
  }

  most_separated_face
}

fn project(&vertices: &List[Vec2], axis: UnitVec2) -> Vec2 {
  let min = F32::inf;
  let max = F32::neg_inf;
  let axis = axis.get();

  for vertex in vertices {
    let p = vertex.dot(axis);
    min = min.min(p);
    max = max.max(p);
  }

  (min, max)
}

// SLOP BELOW: i lowkey gave up and got it to do the rest im tired

fn find_incident_edge(&vertices: &List[Vec2], normal: UnitVec2) -> Option[(Vec2, Vec2)] {
  let first = match vertices.iter_ref().advance() {
    Some(&vertex, _) { vertex }
    None() { return None(); }
  };
  let best = None[(Vec2, Vec2)]();
  let best_score = F32::inf;
  let iter = vertices.iter_ref().forked().peeking();
  while iter.next() is Some(start) {
    let end = iter.peek().as_fork().or_use(first);
    let (x, y) = end - start;
    let outward = match (y, -x).normalize() {
      Some(outward) { outward }
      None() { continue; }
    };
    let score = outward.get().dot(normal.get());
    if score < best_score {
      best_score = score;
      best = Some(start, end);
    }
  }
  best
}

// Keep dot(normal, point) <= offset, including a lone point at a corner.
fn clip_segment(points: List[Vec2], normal: Vec2, offset: F32) -> List[Vec2] {
  let iter = points.iter().peeking();
  let start = match iter.next() {
    Some(start) { start }
    None() { return []; }
  };
  let distance_start = start.dot(normal) - offset;
  let result = [];
  if distance_start <= 0.0 {
    result.push_back(start);
  }
  if iter.next() is Some(end) {
    let distance_end = end.dot(normal) - offset;
    if (distance_start < 0.0 and distance_end > 0.0)
      or (distance_start > 0.0 and distance_end < 0.0) {
      let fraction = distance_start / (distance_start - distance_end);
      result.push_back(start + (end - start) * fraction);
    }
    if distance_end <= 0.0 {
      result.push_back(end);
    }
  }
  result
}

fn build_manifold(reference: Face, &vertices: &List[Vec2], flip_normal: Bool) -> Option[ContactManifold] {
  let (start, end) = match find_incident_edge(&vertices, reference.normal) {
    Some(edge) { edge }
    None() { return None(); }
  };
  let tangent = match (reference.end - reference.start).normalize() {
    Some(tangent) { tangent.get() }
    None() { return None(); }
  };
  let points = clip_segment([start, end], -tangent, (-tangent).dot(reference.start));
  let points = clip_segment(points, tangent, tangent.dot(reference.end));
  let contacts = [];
  for point in points {
    let separation = reference.normal.get().dot(point - reference.start);
    if separation <= 0.0 {
      contacts.push_back(ContactPoint({ position: point, depth: -separation }));
    }
  }
  let point1 = match contacts.pop_front() {
    Some(point) { point }
    None() { return None(); }
  };
  let point2 = contacts.pop_front();
  Some(ContactManifold({
    normal: if flip_normal { -reference.normal } else { reference.normal },
    point1: point1,
    point2: point2,
  }))
}
