mod engine;
mod arithmetic;
mod contact;
mod util;

use arithmetic::Rot2;
use engine::{RigidBody, Engine, Collider};

pub fn main(&io: &IO) {
  let bodies = [
    // The floor's top surface is at y = -5.
    RigidBody({
      position: (0.0, -20.0),
      rotation: Rot2::from_angle(3.1415 / 4.0),
      linear_velocity: (0.0, 0.0),
      angular_velocity: 0.0,
      collider: Collider::Rectangle({ half_size: (10.0, 10.0) }),
      inverse_mass: 0.0,
      restitution: 0.0,
    }),
    RigidBody({
      position: (-20.0, 10.0),
      rotation: Rot2::identity,
      linear_velocity: (0.0, 0.0),
      angular_velocity: 0.0,
      collider: Collider::Rectangle({ half_size: (5.0, 100.0) }),
      inverse_mass: 0.0,
      restitution: 0.0,
    }),
    RigidBody({
      position: (20.0, 10.0),
      rotation: Rot2::identity,
      linear_velocity: (0.0, 0.0),
      angular_velocity: 0.0,
      collider: Collider::Rectangle({ half_size: (5.0, 100.0) }),
      inverse_mass: 0.0,
      restitution: 0.0,
    }),
  ];

  let rows: N32 = 8;
  let spacing: F32 = 2.05;
  let row_height = spacing * (3.0 as F32).sqrt() * 0.5;
  for row in 0..rows {
    let count = rows - row;
    for column in 0..count {
      bodies.push_back(RigidBody({
        position: (
          (column as F32 - (count - 1) as F32 * 0.5) * spacing,
          -3.95 + row as F32 * row_height,
        ),
        rotation: Rot2::identity,
        linear_velocity: (0.0, 0.0),
        angular_velocity: 0.0,
        collider: Collider::Rectangle({ half_size: (1.0, 1.0) }),
        inverse_mass: 1.0 / 2.0,
        restitution: 0.5,
      }));
    }
  }

  let engine = Engine({
    bodies: bodies,
    gravity: (0.0, -9.81 * 2.0),
  });

  loop {
    io.println("FRAME");
    for body in engine.bodies {
      let (x, y) = body.position;
      match body.collider {
        Collider::Circle({ radius }) {
          io.println("CIRCLE {x} {y} {radius}");
        }
        Collider::Rectangle({ half_size }) {
          let (half_width, half_height) = half_size;
          let Rot2(rotation) = body.rotation;
          let (cos, sin) = rotation.get();
          io.println("RECTANGLE {x} {y} {half_width} {half_height} {cos} {sin}");
        }
      }
    }
    io.println("END");
    io.flush();

    match io.read_line() {
      Some(_) {
        engine.update(1.0 / 30.0);
        continue;
      }
      None() { break; }
    }
  }
}
