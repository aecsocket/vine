mod engine;

use engine::{RigidBody, Engine, Collider};

pub fn main(&io: &IO) {
  let engine = Engine({
    bodies: [
      // small ball that falls down onto the...
      RigidBody({
        position: (0.0, 0.0),
        velocity: (0.0, 0.0),
        collider: Collider::Circle({ radius: 1.0 }),
        inverse_mass: 1.0 / 2.0,
        restitution: 0.3,
      }),
      // ...big static body
      RigidBody({
        position: (-50.0, -1020.0),
        velocity: (0.0, 0.0),
        collider: Collider::Circle({ radius: 1000.0 }),
        inverse_mass: 0.0,
        restitution: 0.0,
      }),
    ],
    gravity: (0.0, -9.81),
  });

  loop {
    io.println("FRAME");
    for body in engine.bodies {
      let (x, y) = body.position;
      match body.collider {
        Collider::Circle({ radius }) {
          io.println("{x} {y} {radius}");
        }
      }
    }
    io.println("END");
    io.flush();

    match io.read_line() {
      Some(_) {
        engine.update(1.0 / 60.0);
        continue;
      }
      None() { break; }
    }
  }
}
