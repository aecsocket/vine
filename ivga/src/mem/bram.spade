use std::mem::{WritePort, ReadPort};

/// Xilinx-specific BRAM module.
///
/// `std::mem::Memory` doesn't guarantee the semantics when reading and writing
/// to the same address in the same clock cycle, so we need a wrapper which does
/// so. Xilinx XPM's BRAM supports `.WRITE_MODE_B("read_first")`, which gives us
/// the ordering we need.
#[no_mangle(all)]
pub extern entity xpm_sdpram<#uint WIDTH, #uint DEPTH, #uint INDEX>(
    clk: clock,
    read_addr: uint<INDEX>,
    write_addr: uint<INDEX>,
    write_enable: bool,
    write_data: uint<WIDTH>,
    read_data: inv uint<WIDTH>,
);

pub entity dp_bram<#uint W, D, #uint C>(clk: clock) -> (WritePort<W, D>, ReadPort<W, D>) {
    // write
    let write_addr = port::<uint<W>>();
    let write_data = port::<Option<D>>();

    let write_enable = write_data.0.is_some();
    let write = WritePort {
        addr: write_addr.1,
        write: write_data.1,
    };

    // read
    let read_addr = port::<uint<W>>();
    let read_data = port::<D>();
    let read = ReadPort {
        addr: read_addr.1,
        out: read_data.0,
    };

    inst xpm_sdpram(
        clk,
        read_addr.0,
        write_addr.0,
        write_enable,
        write_data.0.unwrap_or_undef(),
        read_data.1,
    );
    (write, read)
}
