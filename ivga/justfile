target := "target"
top := "src/Top.bsv"
bsc_lib := `printf 'puts $env(BLUESPECDIR)\n' | bluetcl`
bsc := "bsc -promote-warnings ALL -p +:src:src/mem"

default:
  @just --list

sim:
  mkdir -p "{{target}}/bsc"
  mkdir -p "{{target}}/sim"

  {{bsc}} -u -sim -g mkTop \
    -bdir "{{target}}/bsc/" \
    -simdir "{{target}}/sim/" \
    "{{top}}"

  {{bsc}} -sim -e mkTop \
    -bdir "{{target}}/bsc/" \
    -simdir "{{target}}/sim/" \
    -o "{{target}}/top"

  "{{target}}/top"

emit-verilog:
  mkdir -p "{{target}}/bsc/"
  mkdir -p "{{target}}/verilog/"

  {{bsc}} -u -verilog -g mkTop \
    -bdir "{{target}}/bsc/" \
    -vdir "{{target}}/verilog/" \
    "{{top}}"

build: emit-verilog
  mkdir -p "{{target}}/vivado/"

  cd "{{absolute_path(target)}}/vivado" && vivado -mode batch \
    -source "{{justfile_directory()}}/vivado/build.tcl" \
    -log build.log \
    -journal build.jou \
    -tclargs "{{absolute_path(target)}}" "{{bsc_lib}}"

program device="":
  mkdir -p "{{target}}/vivado"
  cd "{{absolute_path(target)}}/vivado" && vivado -mode batch \
    -source "{{justfile_directory()}}/vivado/program.tcl" \
    -log program.log \
    -journal program.jou \
    -tclargs "{{absolute_path(target)}}/vivado/top.bit" "{{device}}"
